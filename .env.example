# --- Base de datos ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=solicitudes
MYSQL_USER=app
MYSQL_PASSWORD=apppass
MYSQL_PORT=3307

# URL usada por el backend dentro de docker compose
DATABASE_URL=mysql+pymysql://app:apppass@db:3306/solicitudes?charset=utf8mb4

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# --- LLM ---
# Proveedor: openai | fake (fake no llama a ningún servicio externo)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_CACHE_TTL_SECONDS=300

# --- Frontend (build de Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
